# MGAgent Admin Backend SQLite 模式配置
# 适用于本地调试，无需外部数据库服务

# ========== 基础配置 ==========
DATABASE_SCHEME=sqlite
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8001
DEBUG=true

# ========== 方案1: SQLite + ChromaDB ==========
SQLITE_DB_PATH=../mgagent-backend/data/chat.db
CHROMA_PERSIST_DIR=../mgagent-backend/data/chroma

# ========== 公共配置 ==========
DOCUMENT_DIR=../mgagent-backend/data/documents