ment"},{"type":"doc","id":"deployment/production-deployment"}],"collapsed":true,"collapsible":true},{"type":"category","label":"🛠️ 开发指南","items":[{"type":"doc","id":"development/project-structure"},{"type":"doc","id":"development/scripts"},{"type":"doc","id":"development/api-reference"}],"collapsed":true,"collapsible":true},{"type":"category","label":"🔧 配置说明","items":[{"type":"doc","id":"configuration/environment-variables"},{"type":"doc","id":"configuration/nginx"},{"type":"doc","id":"configuration/docker"}],"collapsed":true,"collapsible":true},{"type":"category","label":"❓ 常见问题","items":[{"type":"doc","id":"troubleshooting/faq"},{"type":"doc","id":"troubleshooting/common-issues"}],"collapsed":true,"collapsible":true}]}}]}},"docusaurus-plugin-content-blog":{"default":{"blogTitle":"Blog","blogDescription":"Blog","blogSidebarTitle":"Recent posts","blogPosts":[{"id":"2026-07-release","metadata":{"permalink":"/mgagent/blog/2026-07-release","source":"@site/blog/2026-07-release.md","title":"2026年7月 - 双技术栈架构与文档站点","description":"MGAgent 重大更新：支持双技术栈架构，上线 Docusaurus 在线文档站点","date":"2026-07-15T00:00:00.000Z","tags":[{"inline":true,"label":"新功能","permalink":"/mgagent/blog/tags/新功能"},{"inline":true,"label":"架构升级","permalink":"/mgagent/blog/tags/架构升级"},{"inline":true,"label":"文档","permalink":"/mgagent/blog/tags/文档"}],"readingTime":0.98,"hasTruncateMarker":true,"authors":[{"name":"小码哥","title":"MGAgent 核心开发者","url":"https://github.com/xmgfy","imageURL":"https://github.com/xmgfy.png","key":"mgagent","page":null}],"frontMatter":{"slug":"2026-07-release","title":"2026年7月 - 双技术栈架构与文档站点","date":"2026-07-15T00:00:00.000Z","authors":["mgagent"],"tags":["新功能","架构升级","文档"],"description":"MGAgent 重大更新：支持双技术栈架构，上线 Docusaurus 在线文档站点"},"unlisted":false,"nextItem":{"title":"2026年6月 - 模型配置动态化与性能优化","permalink":"/mgagent/blog/2026-06-release"}},"content":"<!-- truncate -->\n\n## 核心更新\n\n### 🎯 双技术栈架构支持\n\nMGAgent 现已支持两套技术栈方案，可根据部署场景灵活选择：\n\n- **方案一：SQLite + ChromaDB**（开发调试）\n  - 轻量级单机部署\n  - 无需外部依赖，快速启动\n  - 适用于个人开发者和小型团队\n\n- **方案二：MySQL + Milvus**（生产部署）\n  - 高性能企业级部署\n  - 支持高并发和大规模数据\n  - 适用于企业生产环境\n\n### 📚 在线文档站点上线\n\n基于 GitHub Pages + Docusaurus 构建的完整在线文档站点已上线：\n\n- 完整的项目文档和 API 参考\n- 交互式 Mermaid 架构图\n- 多语言支持（中文优先）\n- 响应式设计，支持移动端\n\n### 🔧 一键部署脚本\n\n新增 `deploy.sh` 一键部署脚本：\n\n```bash\n# SQLite 方案\n./scripts/deploy.sh sqlite\n\n# MySQL 方案\n./scripts/deploy.sh mysql\n\n# 停止所有服务\n./scripts/deploy.sh stop\n```\n\n## 优化与改进\n\n- 优化 Docker Compose 配置，采用分层部署架构\n- 大模型配置统一从数据库读取，支持动态切换\n- 前端 Admin 端模型配置管理功能完善\n- 修复 Mermaid 图表渲染问题\n\n## 致谢\n\n感谢所有为本次更新做出贡献的开发者！"},{"id":"2026-06-release","metadata":{"permalink":"/mgagent/blog/2026-06-release","source":"@site/blog/2026-06-release.md","title":"2026年6月 - 模型配置动态化与性能优化","description":"MGAgent 模型配置架构重大升级，支持动态加载和热切换","date":"2026-06-20T00:00:00.000Z","tags":[{"inline":true,"label":"性能优化","permalink":"/mgagent/blog/tags/性能优化"},{"inline":true,"label":"动态配置","permalink":"/mgagent/blog/tags/动态配置"},{"inline":true,"label":"新功能","permalink":"/mgagent/blog/tags/新功能"}],"readingTime":0.65,"hasTruncateMarker":true,"authors":[{"name":"小码哥","title":"MGAgent 核心开发者","url":"https://github.com/xmgfy","imageURL":"https://github.com/xmgfy.png","key":"mgagent","page":null}],"frontMatter":{"slug":"2026-06-release","title":"2026年6月 - 模型配置动态化与性能优化","date":"2026-06-20T00:00:00.000Z","authors":["mgagent"],"tags":["性能优化","动态配置","新功能"],"description":"MGAgent 模型配置架构重大升级，支持动态加载和热切换"},"unlisted":false,"prevItem":{"title":"2026年7月 - 双技术栈架构与文档站点","permalink":"/mgagent/blog/2026-07-release"},"nextItem":{"title":"2026年5月 - RAG 增强与多工具支持","permalink":"/mgagent/blog/2026-05-release"}},"content":"<!-- truncate -->\n\n## 核心更新\n\n### ⚙️ 模型配置动态化\n\n- 所有 LLM 配置统一从数据库读取\n- 支持模型参数动态修改，无需重启服务\n- Admin 端模型配置管理界面完善\n- 支持多模型并行配置与切换\n\n### 🚀 性能优化\n\n- Agent 响应速度提升 30%\n- 优化 RAG 检索流程，减少延迟\n- 并发处理能力增强\n- 内存占用优化\n\n### 🔌 插件化架构\n\n- Agent 工具采用插件化设计\n- 新增工具无需修改核心代码\n- 支持第三方工具集成\n- 统一工具接口规范\n\n## 技术改进\n\n- 引入配置缓存机制\n- 优化数据库连接池\n- 增强错误处理和日志记录\n- API 响应标准化\n\n## 下一步计划\n\n- 完善多租户权限体系\n- 增加更多 Agent 工具\n- 优化前端交互体验"},{"id":"2026-05-release","metadata":{"permalink":"/mgagent/blog/2026-05-release","source":"@site/blog/2026-05-release.md","title":"2026年5月 - RAG 增强与多工具支持","description":"MGAgent RAG 检索增强，支持多种 Agent 工具","date":"2026-05-15T00:00:00.000Z","tags":[{"inline":true,"label":"RAG","permalink":"/mgagent/blog/tags/rag"},{"inline":true,"label":"工具集成","permalink":"/mgagent/blog/tags/工具集成"},{"inline":true,"label":"新功能","permalink":"/mgagent/blog/tags/新功能"}],"readingTime":0.83,"hasTruncateMarker":true,"authors":[{"name":"小码哥","title":"MGAgent 核心开发者","url":"https://github.com/xmgfy","imageURL":"https://github.com/xmgfy.png","key":"mgagent","page":null}],"frontMatter":{"slug":"2026-05-release","title":"2026年5月 - RAG 增强与多工具支持","date":"2026-05-15T00:00:00.000Z","authors":["mgagent"],"tags":["RAG","工具集成","新功能"],"description":"MGAgent RAG 检索增强，支持多种 Agent 工具"},"unlisted":false,"prevItem":{"title":"2026年6月 - 模型配置动态化与性能优化","permalink":"/mgagent/blog/2026-06-release"},"nextItem":{"title":"2026年4月 - 项目启动与基础功能","permalink":"/mgagent/blog/2026-04-release"}},"content":"<!-- truncate -->\n\n## 核心更新\n\n### 📖 RAG 检索增强\n\n- 支持多种文档格式（PDF、Word、Markdown、TXT）\n- 向量化过程自动化\n- 相似度检索算法优化\n- 支持重排序（Re-ranking）\n\n### 🛠️ 多工具支持\n\nMGAgent Agent 现已支持多种工具：\n\n- **计算器工具**：自然语言数学计算\n- **数据库查询工具**：自然语言转 SQL\n- **Web 搜索工具**：实时信息检索\n- **代码执行工具**：Python 代码沙箱\n\n### 🔄 工作流引擎\n\n- 多步骤任务自动规划\n- 工具调用链优化\n- 错误自动重试\n- 支持人工干预\n\n## 功能改进\n\n- 对话上下文记忆增强\n- 流式响应体验优化\n- 知识库批量导入\n- 对话历史搜索功能\n\n## 使用示例\n\n```python\n# 初始化 Agent\nagent = MGAgent()\n\n# 自动选择工具\nresponse = agent.chat(\"帮我查询上个月的销售数据并计算增长率\")\n\n# Agent 会自动：\n# 1. 识别意图 -> 数据查询 + 计算\n# 2. 调用数据库工具获取数据\n# 3. 调用计算器工具分析\n# 4. 生成自然语言报告\n```"},{"id":"2026-04-release","metadata":{"permalink":"/mgagent/blog/2026-04-release","source":"@site/blog/2026-04-release.md","title":"2026年4月 - 项目启动与基础功能","description":"MGAgent 项目正式启动，发布基础版本","date":"2026-04-10T00:00:00.000Z","tags":[{"inline":true,"label":"项目启动","permalink":"/mgagent/blog/tags/项目启动"},{"inline":true,"label":"基础功能","permalink":"/mgagent/blog/tags/基础功能"}],"readingTime":0.86,"hasTruncateMarker":true,"authors":[{"name":"小码哥","title":"MGAgent 核心开发者","url":"https://github.com/xmgfy","imageURL":"https://github.com/xmgfy.png","key":"mgagent","page":null}],"frontMatter":{"slug":"2026-04-release","title":"2026年4月 - 项目启动与基础功能","date":"2026-04-10T00:00:00.000Z","authors":["mgagent"],"tags":["项目启动","基础功能"],"description":"MGAgent 项目正式启动，发布基础版本"},"unlisted":false,"prevItem":{"title":"2026年5月 - RAG 增强与多工具支持","permalink":"/mgagent/blog/2026-05-release"}},"content":"<!-- truncate -->\n\n## 项目启动\n\nMGAgent 企业级智能体系统正式发布！\n\n### 🌟 核心功能首发\n\n- **智能对话**：基于大模型的多轮对话能力\n- **上下文理解**：支持多轮对话上下文记忆\n- **意图识别**：精准理解用户意图\n- **流式响应**：实时流式输出，提升交互体验\n\n### 🏗️ 架构设计\n\nMGAgent 采用现代化技术栈构建：\n\n- **后端**：FastAPI + LangChain + SQLAlchemy\n- **前端**：React + TypeScript + Tailwind CSS\n- **存储**：SQLite / MySQL + ChromaDB / Milvus\n- **部署**：Docker Compose 容器化部署\n\n### 📁 项目结构\n\n```\nMGAgent/\n├── app/                    # 后端应用\n│   ├── api/                # API 路由\n│   ├── agent/              # Agent 核心\n│   ├── config/             # 配置模块\n│   ├── db/                 # 数据库\n│   ├── rag/                # RAG 模块\n│   ├── services/           # 服务层\n│   └── tools/              # 工具集\n├── mgagent-frontend/       # Chat 前端\n├── mgagent-admin-frontend/ # Admin 前端\n├── scripts/                # 部署脚本\n└── docker/                 # Docker 配置\n```\n\n### 🚀 快速开始\n\n```bash\n# 克隆项目\ngit clone https://github.com/xmgfy/mgagent.git\n\n# 进入目录\ncd mgagent\n\n# SQLite 方案一键启动\n./scripts/deploy.sh sqlite\n\n# 或 MySQL 方案一键启动\n./scripts/deploy.sh mysql\n```\n\n## 致谢\n\n感谢每一位参与项目开发和测试的朋友！"}],"blogTags":{"/mgagent/blog/tags/新功能":{"inline":true,"label":"新功能","permalink":"/mgagent/blog/tags/新功能","items":["2026-07-release","2026-06-release","2026-05-release"],"pages":[{"items":["2026-07-release","2026-06-release","2026-05-release"],"metadata":{"permalink":"/mgagent/blog/tags/新功能","page":1,"postsPerPage":10,"totalPages":1,"tot