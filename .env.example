# MGAgent 环境变量配置示例
# 复制此文件为 .env 并修改配置

# MySQL 数据库配置
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=mgagent
MYSQL_USER=mgagent
MYSQL_PASSWORD=your_password
MYSQL_PORT=3306

# Milvus 向量数据库配置
MILVUS_PORT=19530
MILVUS_GRPC_PORT=9091

# 后端服务端口配置
BACKEND_PORT=8000
ADMIN_BACKEND_PORT=8001

# 前端服务端口配置
FRONTEND_PORT=3000
ADMIN_FRONTEND_PORT=3001

# 数据库连接 URL（本地开发使用）
# DATABASE_URL=mysql+pymysql://mgagent:your_password@localhost:3306/mgagent?charset=utf8mb4

# Milvus 配置（本地开发使用）
# MILVUS_HOST=localhost
# MILVUS_PORT_CONFIG=19530
