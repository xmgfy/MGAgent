# ============================================
# MGAgent 生产环境配置模板
# 复制此文件为 .env.production 并修改配置
# ============================================

# ========== MySQL 数据库配置 ==========
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=mgagent
MYSQL_USER=mgagent
MYSQL_PASSWORD=your_password_here
MYSQL_PORT=3306

# ========== Milvus 向量数据库配置 ==========
MILVUS_PORT=19530
MILVUS_GRPC_PORT=9091

# ========== MinIO 对象存储配置 ==========
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# ========== 服务端口配置 ==========
# Chat 前端端口
CHAT_FRONTEND_PORT=3000

# Admin 前端端口
ADMIN_FRONTEND_PORT=3001

# Chat 后端端口
CHAT_BACKEND_PORT=8000

# Admin 后端端口
ADMIN_BACKEND_PORT=8001

# Attu UI 端口
ATTU_PORT=8003

# ========== 服务器配置 ==========
# 服务器 IP 或域名（用于生成访问地址）
# SERVER_HOST=your-server-domain.com

# ========== 安全配置 ==========
# 生产环境请确保:
# 1. 使用强密码（至少 16 位，包含大小写字母、数字和特殊字符）
# 2. 不要将此文件提交到 Git
# 3. 定期轮换密码
# 4. 配置防火墙仅开放必要端口（3000, 3001）